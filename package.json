{
  "name": "feldspar",
  "version": "0.1.0",
  "private": true,
  "homepage": "/",
  "dependencies": {
    "@supabase/supabase-js": "^2.47.13",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.59",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "concurrently": "^8.2.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lodash": "^4.17.21",
    "lottie-react": "^2.3.1",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.3.0",
    "typescript": "^4.4.3",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "prepare": "husky install",
    "check:ts": "ts-standard --env jest",
    "fix:ts": "ts-standard --env jest --fix",
    "lint:json": "jsonlint package.json vercel.json",
    "clean": "rm -rf ./build",
    "build:css": "NODE_ENV=production tailwindcss build -i ./src/framework/styles.css -o ./build/styles.css --minify",
    "build:wheel": "cd src/framework/processing/py && python3 -m pip install --user poetry && python3 -m poetry build --format wheel",
    "build:install-wheel": "cp -R src/framework/processing/py/dist/. ./public",
    "build:py": "if command -v python3 &> /dev/null; then npm run build:wheel && npm run build:install-wheel; else echo 'Python 3 not found. Please install Python 3.'; fi",
    "build:app": "react-scripts build",
    "start:py": "nodemon --ext py --exec \"npm run build:py\"",
    "start:app": "react-scripts start",
    "start": "concurrently 'npm run start:py' 'npm run start:app'",
    "build": "npm run build:py && npm run build:app && npm run build:css",
    "release": "npm run build && ./release.sh $npm_package_name",
    "deploy": "vercel --prod",
    "test": "react-scripts test",
    "lint": "npm run fix:ts"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/lodash": "^4.14.185",
    "autoprefixer": "^10.4.12",
    "husky": "^8.0.1",
    "jsonlint": "^1.6.3",
    "nodemon": "^3.1.9",
    "postcss": "^8.4.16",
    "react-scripts": "^5.0.1",
    "tailwindcss": "^3.1.8",
    "ts-standard": "^11.0.0"
  },
  "ts-standard": {
    "project": "./tsconfig.json",
    "ignore": [
      "dist",
      "src/framework/processing/py_worker.js"
    ]
  }
}
